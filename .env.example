# Database Configuration
# PostgreSQL connection string format: postgresql://user:password@host:port/database
#
# For Docker setup (using docker-compose):
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/posutochka

# For custom Docker container (if running manually with port 5433):
# DATABASE_URL=postgresql://postgres:123456@localhost:5433/posutochka

# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
